 "changes": [
  {
   "what": "Buns toasted after the patties, not before",
   "why": "Buns toasted first sit for 15+ minutes and go cold. The patties rest while the buns toast in the same pan."
  },
  {
   "what": "Onions rewarm on top of the cheese, under the lid",
   "why": "They finish well before the patties. The lid melts the cheese and rewarms them in the same 1–2 minutes."
  },
  {
   "what": "Total time is about an hour, not 45 minutes",
   "why": "One pan does onions, then patties, then buns, in turn."
  },
  {
   "what": "Chips timed back from the burgers",
   "why": "The page tells you when to put them in, so they finish together."
  },
  {
   "what": "Probe, not colour",
   "why": "Minced beef must reach 75°C for 30 s, or 70°C for 2 min, at the centre. Crust colour does not tell you."
  }
 ]
