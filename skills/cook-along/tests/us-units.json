 "changes": [
  {
   "what": "Salmon is cooked until it is opaque and flakes",
   "why": "The video takes it out at 125°F (52°C), which leaves the centre translucent. UK guidance for fish is opaque and flaking. If you like it rarer, that is your call, but not for anyone pregnant, elderly, very young or unwell."
  },
  {
   "what": "Amounts added",
   "why": "The video gives few amounts. The ones marked 'suggested' are for 2 people."
  },
  {
   "what": "1 tbsp of dressing kept clean",
   "why": "Set aside before the raw fish goes in, so you can spoon it over at the table safely."
  },
  {
   "what": "Oven in °C",
   "why": "400°F is 200°C conventional or 180°C fan."
  }
 ]
